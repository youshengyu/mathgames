  <script>
    // Game Constants
    const TOTAL_ROUNDS = 10;
    let currentRound = 1;
    let rolledDice = null; // [d1, d2]
    let isDiceRolled = false;
    let selectedPairKey = null;

    /* 
      Exact Layout Grid Matrix Matching Image (4 rows x 6 columns)
      Row 0: [ null, cell, cell, cell, cell, null ] -> 4 cells
      Row 1: [ cell, cell, cell, cell, cell, cell ] -> 6 cells
      Row 2: [ cell, cell, cell, cell, cell, cell ] -> 6 cells
      Row 3: [ null, cell, cell, cell, cell, null ] -> 4 cells
      Total = 20 cells (10 symmetrical pairs)
    */
    const LAYOUT_MASK = [
      [false, true,  true,  true,  true,  false], 
      [true,  true,  true,  true,  true,  true ], 
      [true,  true,  true,  true,  true,  true ], 
      [false, true,  true,  true,  true,  false]  
    ];

    let boardState = Array.from({ length: 4 }, () => Array(6).fill(null));

    function getPairKey(r, c) {
      const minCol = Math.min(c, 5 - c);
      return `${r}-${minCol}`;
    }

    // DOM Elements
    const boardContainerEl = document.getElementById('board-container');
    const dice1El = document.getElementById('dice-1');
    const dice2El = document.getElementById('dice-2');
    const btnRoll = document.getElementById('btn-roll');
    const btnReset = document.getElementById('btn-reset');
    const roundDisplay = document.getElementById('round-display');
    const statusHint = document.getElementById('status-hint');
    const playerNameInput = document.getElementById('player-name');

    // Leaderboard DOM
    const leaderboardModal = document.getElementById('leaderboard-modal');
    const leaderboardTbody = document.getElementById('leaderboard-tbody');
    const btnLeaderboard = document.getElementById('btn-leaderboard');
    const btnCloseLeaderboard = document.getElementById('btn-close-leaderboard');
    const btnCloseLeaderboardFooter = document.getElementById('btn-close-leaderboard-footer');
    const btnClearLeaderboard = document.getElementById('btn-clear-leaderboard');
    const btnModalLeaderboard = document.getElementById('btn-modal-leaderboard');
    const modalRankBadge = document.getElementById('modal-rank-badge');
    const modalRankText = document.getElementById('modal-rank-text');

    const LEADERBOARD_KEY = 'splitter_leaderboard_v1';

    function getLeaderboard() {
      try {
        const data = localStorage.getItem(LEADERBOARD_KEY);
        return data ? JSON.parse(data) : [];
      } catch (e) {
        return [];
      }
    }

    function saveLeaderboard(list) {
      try {
        localStorage.setItem(LEADERBOARD_KEY, JSON.stringify(list));
      } catch (e) {
        console.error('Failed to save leaderboard', e);
      }
    }

    function addScoreToLeaderboard(name, score) {
      const list = getLeaderboard();
      const now = new Date();
      const dateStr = `${now.getMonth() + 1}/${now.getDate()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      
      const newEntry = {
        name: name || '無名玩家',
        score: score,
        date: dateStr,
        timestamp: Date.now()
      };

      list.push(newEntry);
      // Sort descending by score, then newer first
      list.sort((a, b) => b.score - a.score || b.timestamp - a.timestamp);
      
      // Keep Top 10
      const trimmedList = list.slice(0, 10);
      saveLeaderboard(trimmedList);

      // Find rank of new entry
      const rankIndex = trimmedList.findIndex(item => item.timestamp === newEntry.timestamp);
      return rankIndex !== -1 ? rankIndex + 1 : null;
    }

    function renderLeaderboardUI() {
      const list = getLeaderboard();
      leaderboardTbody.innerHTML = '';

      if (list.length === 0) {
        leaderboardTbody.innerHTML = `
          <tr>
            <td colspan="4" class="py-8 text-slate-400 font-medium">尚無任何成績紀錄，快來挑戰第一名！</td>
          </tr>
        `;
        return;
      }

      list.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.className = index % 2 === 0 ? 'bg-white' : 'bg-slate-50/60';

        let rankBadge = `<span class="font-bold text-slate-500">${index + 1}</span>`;
        if (index === 0) rankBadge = `<span class="text-amber-500 font-black text-sm"><i class="fa-solid fa-trophy"></i> 1</span>`;
        else if (index === 1) rankBadge = `<span class="text-slate-400 font-black text-sm"><i class="fa-solid fa-medal"></i> 2</span>`;
        else if (index === 2) rankBadge = `<span class="text-amber-700 font-black text-sm"><i class="fa-solid fa-award"></i> 3</span>`;

        tr.innerHTML = `
          <td class="py-2.5 px-2 font-bold">${rankBadge}</td>
          <td class="py-2.5 px-2 text-left font-bold text-slate-800 truncate max-w-[120px]">${item.name}</td>
          <td class="py-2.5 px-2 font-black text-indigo-600 text-sm">${item.score} <span class="text-[10px] font-normal text-slate-400">分</span></td>
          <td class="py-2.5 px-2 text-[11px] text-slate-400">${item.date}</td>
        `;
        leaderboardTbody.appendChild(tr);
      });
    }

    function openLeaderboardModal() {
      renderLeaderboardUI();
      leaderboardModal.classList.remove('hidden');
    }

    function closeLeaderboardModal() {
      leaderboardModal.classList.add('hidden');
    }

    // Modals
    const placementModal = document.getElementById('placement-modal');
    const optOrder1Btn = document.getElementById('opt-order-1');
    const optOrder2Btn = document.getElementById('opt-order-2');
    const btnCancelPlacement = document.getElementById('btn-cancel-placement');
    const opt1Val1 = document.getElementById('opt1-val1');
    const opt1Val2 = document.getElementById('opt1-val2');
    const opt2Val1 = document.getElementById('opt2-val1');
    const opt2Val2 = document.getElementById('opt2-val2');

    const gameoverModal = document.getElementById('gameover-modal');
    const modalFinalScore = document.getElementById('modal-final-score');
    const modalPlayerDisplay = document.getElementById('modal-player-display');
    const btnModalRestart = document.getElementById('btn-modal-restart');
    
    const btnViewBoard = document.getElementById('btn-view-board');
    const viewBoardBanner = document.getElementById('view-board-banner');
    const btnReopenModal = document.getElementById('btn-reopen-modal');
    const btnBannerRestart = document.getElementById('btn-banner-restart');

    // Enlarged cell sizing classes
    const CELL_SIZE_CLASSES = 'w-12 h-12 sm:w-16 sm:h-16 md:w-18 md:h-18 lg:w-20 lg:h-20';

    function initBoardUI() {
      boardContainerEl.innerHTML = '';

      for (let r = 0; r < 4; r++) {
        const rowDiv = document.createElement('div');
        rowDiv.className = 'flex items-center justify-center gap-2 sm:gap-2.5 md:gap-3';

        for (let c = 0; c < 6; c++) {
          if (!LAYOUT_MASK[r][c]) {
            // Placeholder for convex symmetry shape alignment
            const placeholder = document.createElement('div');
            placeholder.className = `${CELL_SIZE_CLASSES} opacity-0 pointer-events-none`;
            if (c === 2) placeholder.classList.add('mr-4', 'sm:mr-6', 'md:mr-8');
            rowDiv.appendChild(placeholder);
            continue;
          }

          const cell = document.createElement('button');
          cell.id = `cell-${r}-${c}`;
          cell.dataset.row = r;
          cell.dataset.col = c;
          const pairKey = getPairKey(r, c);
          cell.dataset.pair = pairKey;

          const val = boardState[r][c];
          if (val !== null) {
            cell.innerText = val;
            cell.className = `board-cell ${CELL_SIZE_CLASSES} bg-indigo-50 border-2 md:border-3 border-indigo-600 rounded-xl font-black text-2xl sm:text-3xl md:text-4xl text-indigo-700 flex items-center justify-center cell-filled shadow-sm`;
          } else {
            cell.innerText = '';
            cell.className = `board-cell ${CELL_SIZE_CLASSES} bg-white border-2 md:border-3 border-slate-300 rounded-xl font-bold text-slate-400 hover:border-indigo-400 hover:bg-indigo-50/30 transition-all flex items-center justify-center shadow-xs`;
          }

          if (c === 2) cell.classList.add('mr-4', 'sm:mr-6', 'md:mr-8');

          cell.addEventListener('mouseenter', () => highlightPair(pairKey, true));
          cell.addEventListener('mouseleave', () => highlightPair(pairKey, false));
          cell.addEventListener('click', () => handleCellClick(r, c));

          rowDiv.appendChild(cell);
        }
        boardContainerEl.appendChild(rowDiv);
      }
    }

    // Render 3D Dots on Dice
    function renderDiceFace(el, val) {
      el.innerHTML = '';
      if (val === '?' || !val) {
        el.innerHTML = `<span class="text-2xl md:text-3xl font-black text-indigo-600">?</span>`;
        return;
      }

      const grid = document.createElement('div');
      grid.className = 'w-full h-full grid grid-cols-3 grid-rows-3 gap-0.5 pointer-events-none items-center justify-items-center';

      const activeIndices = {
        1: [4],       // Center (Red dot)
        2: [2, 6],    // Top-right, bottom-left
        3: [2, 4, 6]  // Top-right, center, bottom-left
      }[val] || [];

      for (let i = 0; i < 9; i++) {
        const dotCell = document.createElement('div');
        dotCell.className = 'w-full h-full flex items-center justify-center';
        if (activeIndices.includes(i)) {
          const dot = document.createElement('div');
          const dotColor = val === 1 ? 'bg-rose-600 shadow-rose-200' : 'bg-slate-900 shadow-slate-200';
          dot.className = `w-2.5 h-2.5 md:w-3.5 md:h-3.5 ${dotColor} rounded-full shadow-inner transition-all scale-100`;
          dotCell.appendChild(dot);
        }
        grid.appendChild(dotCell);
      }
      el.appendChild(grid);
    }

    // Highlight Symmetrical Pair
    function highlightPair(pairKey, isHover) {
      if (!isDiceRolled) return;

      const cells = document.querySelectorAll(`[data-pair="${pairKey}"]`);
      cells.forEach(cell => {
        const r = parseInt(cell.dataset.row);
        const c = parseInt(cell.dataset.col);
        if (boardState[r][c] === null) {
          if (isHover) {
            cell.classList.add('bg-indigo-100', 'border-indigo-600');
          } else {
            cell.classList.remove('bg-indigo-100', 'border-indigo-600');
          }
        }
      });
    }

    function rollDice() {
      if (currentRound > TOTAL_ROUNDS) {
        openGameOverModal();
        return;
      }
      if (isDiceRolled) return;

      btnRoll.disabled = true;
      btnRoll.classList.add('opacity-50', 'cursor-not-allowed');

      dice1El.classList.add('dice-rolling');
      dice2El.classList.add('dice-rolling');

      const d1 = Math.floor(Math.random() * 3) + 1;
      const d2 = Math.floor(Math.random() * 3) + 1;

      let rolls = 0;
      const interval = setInterval(() => {
        const temp1 = Math.floor(Math.random() * 3) + 1;
        const temp2 = Math.floor(Math.random() * 3) + 1;
        renderDiceFace(dice1El, temp1);
        renderDiceFace(dice2El, temp2);
        rolls++;

        if (rolls > 9) {
          clearInterval(interval);
          rolledDice = [d1, d2];
          
          dice1El.classList.remove('dice-rolling');
          dice2El.classList.remove('dice-rolling');

          renderDiceFace(dice1El, d1);
          renderDiceFace(dice2El, d2);
          
          isDiceRolled = true;
          statusHint.innerHTML = `<span class="text-indigo-600 font-bold">請點擊遊戲盤上任一對稱對</span> 來放置 [${d1}, ${d2}]`;
        }
      }, 70);
    }

    function handleCellClick(r, c) {
      if (!isDiceRolled) {
        statusHint.innerHTML = `<span class="text-rose-500 font-bold">請先點擊「擲骰子」！</span>`;
        return;
      }

      if (boardState[r][c] !== null) {
        statusHint.innerHTML = `<span class="text-rose-500 font-bold">此位置已填寫過，請選擇其他對稱組！</span>`;
        return;
      }

      selectedPairKey = getPairKey(r, c);
      openPlacementModal();
    }

    function openPlacementModal() {
      const [d1, d2] = rolledDice;
      
      renderDiceFace(opt1Val1, d1);
      renderDiceFace(opt1Val2, d2);

      renderDiceFace(opt2Val1, d2);
      renderDiceFace(opt2Val2, d1);

      placementModal.classList.remove('hidden');
    }

    function closePlacementModal() {
      placementModal.classList.add('hidden');
      selectedPairKey = null;
    }

    function placeDice(leftVal, rightVal) {
      if (!selectedPairKey) return;

      const [rStr, minColStr] = selectedPairKey.split('-');
      const r = parseInt(rStr);
      const leftCol = parseInt(minColStr);
      const rightCol = 5 - leftCol;

      boardState[r][leftCol] = leftVal;
      boardState[r][rightCol] = rightVal;

      updateCellUI(r, leftCol, leftVal);
      updateCellUI(r, rightCol, rightVal);

      closePlacementModal();

      currentRound++;
      isDiceRolled = false;

      if (currentRound <= TOTAL_ROUNDS) {
        roundDisplay.innerText = `第 ${currentRound} / ${TOTAL_ROUNDS} 回合`;
        renderDiceFace(dice1El, '?');
        renderDiceFace(dice2El, '?');
        btnRoll.disabled = false;
        btnRoll.classList.remove('opacity-50', 'cursor-not-allowed');
        statusHint.innerText = '請點擊「擲骰子」進行下一回合';
      } else {
        roundDisplay.innerText = `已完成 10 回合`;
        statusHint.innerText = '遊戲結束！可點擊觀看盤面或查看結算';
        btnRoll.innerHTML = '<i class="fa-solid fa-trophy"></i> 查看得分結算';
        btnRoll.disabled = false;
        btnRoll.classList.remove('opacity-50', 'cursor-not-allowed');
        calculateScoreAndHighlight();
      }
    }

    function updateCellUI(r, c, val) {
      const cell = document.getElementById(`cell-${r}-${c}`);
      cell.innerText = val;
      cell.className = `board-cell ${CELL_SIZE_CLASSES} bg-indigo-50 border-2 md:border-3 border-indigo-600 rounded-xl font-black text-2xl sm:text-3xl md:text-4xl text-indigo-700 flex items-center justify-center cell-filled shadow-sm`;
      if (c === 2) cell.classList.add('mr-4', 'sm:mr-6', 'md:mr-8');
    }

    function calculateScoreAndHighlight() {
      const visited = Array.from({ length: 4 }, () => Array(6).fill(false));
      const scores = { 1: { count: 0, score: 0 }, 2: { count: 0, score: 0 }, 3: { count: 0, score: 0 } };

      const dr = [-1, 1, 0, 0];
      const dc = [0, 0, -1, 1];

      const validGroups = [];
      const invalidGroups = [];

      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 6; c++) {
          if (LAYOUT_MASK[r][c] && !visited[r][c] && boardState[r][c] !== null) {
            const targetVal = boardState[r][c];
            const currentGroup = [];
            const queue = [[r, c]];
            visited[r][c] = true;

            while (queue.length > 0) {
              const [currR, currC] = queue.shift();
              currentGroup.push([currR, currC]);

              for (let i = 0; i < 4; i++) {
                const nr = currR + dr[i];
                const nc = currC + dc[i];

                if (
                  nr >= 0 && nr < 4 && nc >= 0 && nc < 6 &&
                  LAYOUT_MASK[nr][nc] &&
                  !visited[nr][nc] &&
                  boardState[nr][nc] === targetVal
                ) {
                  visited[nr][nc] = true;
                  queue.push([nr, nc]);
                }
              }
            }

            const groupSize = currentGroup.length;
            if (groupSize === targetVal) {
              if (scores[targetVal]) {
                scores[targetVal].count += 1;
                scores[targetVal].score += targetVal;
              }
              validGroups.push(currentGroup);
            } else {
              invalidGroups.push(currentGroup);
            }
          }
        }
      }

      // Highlight Valid Scoring Groups (Green)
      validGroups.forEach(group => {
        group.forEach(([r, c]) => {
          const cell = document.getElementById(`cell-${r}-${c}`);
          cell.className = `board-cell ${CELL_SIZE_CLASSES} bg-emerald-100 border-2 md:border-3 border-emerald-600 rounded-xl font-black text-2xl sm:text-3xl md:text-4xl text-emerald-800 flex items-center justify-center shadow-md`;
          if (c === 2) cell.classList.add('mr-4', 'sm:mr-6', 'md:mr-8');
        });
      });

      // Highlight Invalid Groups (Red)
      invalidGroups.forEach(group => {
        group.forEach(([r, c]) => {
          const cell = document.getElementById(`cell-${r}-${c}`);
          cell.className = `board-cell ${CELL_SIZE_CLASSES} bg-rose-100 border-2 md:border-3 border-rose-400 rounded-xl font-black text-2xl sm:text-3xl md:text-4xl text-rose-500 flex items-center justify-center opacity-80 shadow-sm`;
          if (c === 2) cell.classList.add('mr-4', 'sm:mr-6', 'md:mr-8');
        });
      });

      // Update Score Table
      let total = 0;
      [1, 2, 3].forEach(num => {
        const row = document.getElementById(`score-row-${num}`);
        row.querySelector('.count-cell').innerText = scores[num].count;
        row.querySelector('.score-cell').innerText = scores[num].score;
        total += scores[num].score;
      });

      document.getElementById('total-score').innerText = total;
      modalFinalScore.innerText = total;

      const playerName = playerNameInput.value.trim() || '無名玩家';
      modalPlayerDisplay.innerText = `玩家：${playerName}`;

      // Save to Leaderboard & show rank badge if top 10
      const rank = addScoreToLeaderboard(playerName, total);
      if (rank !== null) {
        modalRankBadge.classList.remove('hidden');
        modalRankText.innerText = `榮登排行榜 第 ${rank} 名！`;
      } else {
        modalRankBadge.classList.add('hidden');
      }

      setTimeout(() => {
        openGameOverModal();
      }, 500);
    }

    function openGameOverModal() {
      gameoverModal.classList.remove('hidden');
      if (viewBoardBanner) viewBoardBanner.classList.add('hidden');
    }

    function viewBoard() {
      gameoverModal.classList.add('hidden');
      if (viewBoardBanner) viewBoardBanner.classList.remove('hidden');
    }

    function resetGame() {
      currentRound = 1;
      rolledDice = null;
      isDiceRolled = false;
      selectedPairKey = null;
      boardState = Array.from({ length: 4 }, () => Array(6).fill(null));

      roundDisplay.innerText = `第 1 / 10 回合`;
      renderDiceFace(dice1El, '?');
      renderDiceFace(dice2El, '?');
      statusHint.innerText = '請點擊「擲骰子」開始回合';
      btnRoll.innerHTML = '<i class="fa-solid fa-dice text-lg"></i> 擲骰子 (1~3點)';
      btnRoll.disabled = false;
      btnRoll.classList.remove('opacity-50', 'cursor-not-allowed');

      [1, 2, 3].forEach(num => {
        const row = document.getElementById(`score-row-${num}`);
        row.querySelector('.count-cell').innerText = '-';
        row.querySelector('.score-cell').innerText = '-';
      });
      document.getElementById('total-score').innerText = '-';

      initBoardUI();
      gameoverModal.classList.add('hidden');
      if (viewBoardBanner) viewBoardBanner.classList.add('hidden');
    }

    // Attach Event Listeners
    btnRoll.addEventListener('click', rollDice);
    btnReset.addEventListener('click', resetGame);
    btnModalRestart.addEventListener('click', resetGame);
    btnViewBoard.addEventListener('click', viewBoard);
    btnReopenModal.addEventListener('click', openGameOverModal);
    btnBannerRestart.addEventListener('click', resetGame);

    // Leaderboard Event Listeners
    btnLeaderboard.addEventListener('click', openLeaderboardModal);
    btnCloseLeaderboard.addEventListener('click', closeLeaderboardModal);
    btnCloseLeaderboardFooter.addEventListener('click', closeLeaderboardModal);
    btnModalLeaderboard.addEventListener('click', () => {
      openLeaderboardModal();
    });
    btnClearLeaderboard.addEventListener('click', () => {
      if (confirm('確定要清空所有歷史排行榜紀錄嗎？')) {
        saveLeaderboard([]);
        renderLeaderboardUI();
      }
    });

    optOrder1Btn.addEventListener('click', () => {
      placeDice(rolledDice[0], rolledDice[1]);
    });

    optOrder2Btn.addEventListener('click', () => {
      placeDice(rolledDice[1], rolledDice[0]);
    });

    btnCancelPlacement.addEventListener('click', closePlacementModal);

    // Initial Load
    window.onload = () => {
      initBoardUI();
    };
  </script>
</body>
</html>
