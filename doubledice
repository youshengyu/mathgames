<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>雙骰對映 - 初階版</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap');
    
    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: #f8fafc;
    }

    /* Board cell animation */
    .board-cell {
      aspect-ratio: 1 / 1;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cell-filled {
      animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes popIn {
      0% { transform: scale(0.85); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    /* 3D Dice Face & Shadow styling */
    .dice-3d {
      position: relative;
      background: linear-gradient(145deg, #ffffff, #f1f5f9);
      box-shadow: 
        0px 6px 0px #cbd5e1,
        0px 10px 15px rgba(0, 0, 0, 0.12),
        inset -2px -2px 4px rgba(0, 0, 0, 0.05),
        inset 2px 2px 4px rgba(255, 255, 255, 0.9);
      transition: transform 0.1s ease, box-shadow 0.1s ease;
      transform-style: preserve-3d;
    }

    .dice-3d:active {
      transform: translateY(3px);
      box-shadow: 
        0px 3px 0px #cbd5e1,
        0px 5px 8px rgba(0, 0, 0, 0.12);
    }

    /* 3D Dice Tumble Animation during roll */
    @keyframes diceTumble {
      0% { transform: rotate(0deg) scale(0.9) translateY(0); }
      25% { transform: rotate(90deg) scale(1.1) translateY(-10px); }
      50% { transform: rotate(180deg) scale(0.95) translateY(0); }
      75% { transform: rotate(270deg) scale(1.05) translateY(-5px); }
      100% { transform: rotate(360deg) scale(1) translateY(0); }
    }

    .dice-rolling {
      animation: diceTumble 0.12s infinite linear;
    }

    @media print {
      .no-print { display: none !important; }
      body { background: white; padding: 0; }
    }
  </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col justify-between p-3 md:p-6">

